{
  "name": "trpg-session-engine",
  "version": "0.1.0",
  "description": "AI-powered TRPG Game Master session engine (Phase 1 MVP core)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsc -p tsconfig.json && node dist/persistence/migrate.js",
    "gm:demo": "tsc -p tsconfig.json && chcp 65001>nul && node scripts/try-codex-gm.mjs",
    "build:server": "tsc -p tsconfig.json",
    "play": "tsc -p tsconfig.json && chcp 65001>nul && node dist/server.js",
    "start": "node dist/server.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "fast-check": "^3.23.1",
    "happy-dom": "15.11.7",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "ws": "^8.21.0"
  }
}
