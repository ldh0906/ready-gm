# Copy to .env and fill in. The .env file is git-ignored.
# Supabase project (server-side only — never expose the secret key to clients).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Postgres connection string for the durable persistence layer + migrations.
# DATABASE_URL is preferred; SUPABASE_DB_URL is used as a fallback.
# On Supabase: Project Settings → Database → Connection string (URI).
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
