# Copy to .env and fill in. The .env file is git-ignored.
# Supabase project (server-side only — never expose the secret key to clients).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Postgres connection string for the durable persistence layer + migrations.
# DATABASE_URL is preferred; SUPABASE_DB_URL is used as a fallback.
# On Supabase: Project Settings → Database → Connection string (URI).
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# --- Playtest server (src/server.ts) ------------------------------------------
# Listen port (default 8787) and host. HOST defaults to 127.0.0.1 (loopback /
# local-only). Set HOST=0.0.0.0 to expose on the network — this REQUIRES
# PLAYTEST_TOKEN to be set, or the server refuses to start.
# PORT=8787
# HOST=127.0.0.1

# Shared secret required by POST /play/new and the /ws WebSocket when set. Hand
# out the play link as https://host/?token=<value>. Use a long random value,
# e.g. `node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"`.
# PLAYTEST_TOKEN=

# AI GM brain: which locally-installed CLI drives the GM. `codex` (default) uses
# the OpenAI Codex CLI (`codex exec`); `claude` uses the Claude Code CLI
# (`claude -p`). The selected CLI must be installed and authenticated on PATH.
# AI_GM_CLI=codex

# Codex reasoning effort (only applies when AI_GM_CLI=codex): minimal|low|medium|high.
# Default `low` — the cost-effective setting. Raise to `medium`/`high` for richer
# reasoning at higher token cost.
# CODEX_REASONING_EFFORT=low
